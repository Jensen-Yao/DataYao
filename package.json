{
  "name": "datayao",
  "version": "0.1.0",
  "description": "Fast, stable offline file transfer over animated QR codes.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "keywords": [
    "qr",
    "offline",
    "file-transfer",
    "fountain-code"
  ],
  "author": "Jensen Yao",
  "license": "MIT",
